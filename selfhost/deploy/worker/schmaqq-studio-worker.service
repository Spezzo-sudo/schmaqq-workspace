[Unit]
Description=SCHMAQQ Studio server worker (isolated runner)
Documentation=file:///usr/local/lib/schmaqq-worker/current/selfhost/deploy/worker/README.md
After=network-online.target var-lib-schmaqq\x2dworker.mount schmaqq-worker-egress.service schmaqq-worker-launcher.service
Wants=network-online.target schmaqq-worker-egress.service schmaqq-worker-launcher.service
Requires=var-lib-schmaqq\x2dworker.mount

[Service]
User=schmaqq-worker
Group=schmaqq-worker
WorkingDirectory=/var/lib/schmaqq-worker
Environment=HOME=/var/lib/schmaqq-worker
Environment=PATH=/usr/local/lib/schmaqq-worker/node/bin:/usr/bin:/bin
Environment=NODE_ENV=production
# All outbound traffic goes through the allowlist proxy (Node fetch, git, npm).
Environment=HTTPS_PROXY=http://127.0.0.60:3128 HTTP_PROXY=http://127.0.0.60:3128
Environment=https_proxy=http://127.0.0.60:3128 http_proxy=http://127.0.0.60:3128
Environment=NODE_USE_ENV_PROXY=1
# The job launcher is local and must never be reached through the proxy.
Environment=NO_PROXY=127.0.0.62 no_proxy=127.0.0.62
ExecStart=/usr/local/lib/schmaqq-worker/node/bin/node /usr/local/lib/schmaqq-worker/current/selfhost/runner.mjs /etc/schmaqq-worker/runner.json
Restart=on-failure
RestartSec=10
UMask=0077

# Privileges: no capabilities, no privilege gain, no extra groups (no docker).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

# Filesystem: everything read-only; only the disk-limited worker volume is writable.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ReadWritePaths=/var/lib/schmaqq-worker
# Other services' programs and data are not visible at all.
# /run is replaced too: no local service sockets (database, D-Bus, snapd, ...) are visible.
TemporaryFileSystem=/opt:ro /srv:ro /var/lib:ro /var/backups:ro /mnt:ro /media:ro /run:ro
BindPaths=/var/lib/schmaqq-worker
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/containerd -/etc/schmaqq-studio.env -/etc/schmaqq-r25-preview.env

# Network: nothing directly – no internet, no DNS (data could leave in queries),
# no unix sockets (also abstract ones). Only the egress proxy on 127.0.0.60 is
# reachable, plus the job launcher on 127.0.0.62. socketpair() for child
# process pipes is not affected.
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.60/32 127.0.0.62/32

# Resources for all jobs together. Per-job time limits come from the runner.
MemoryMax=2G
MemorySwapMax=0
CPUQuota=150%
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target

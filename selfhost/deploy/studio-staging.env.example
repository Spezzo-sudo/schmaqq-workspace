# Staging instance (STUDIO_INSTANCE=staging in studio-deploy.sh). Copy to /etc/schmaqq-studio-staging.env (0600, root).
# Shares NOTHING with production: own address, ports, data directory, accounts and invitations.
# Put an extra access gate (e.g. proxy basic auth or IP allowlist) in front of the staging address;
# Studio's own login is not the only protection for an unreleased branch.
STUDIO_ORIGIN=https://staging.example.com
STUDIO_PREVIEW_ORIGIN=https://staging-preview.example.com
STUDIO_BIND=127.0.0.1
PORT=4330
STUDIO_PREVIEW_PORT=4331
STUDIO_DATA_DIR=/var/lib/schmaqq-studio-staging
NODE_ENV=production

# Deliberately NOT set on staging (do not copy from production):
# - GitHub OAuth/PR tokens (STUDIO_GITHUB_*): no access to real repositories from an unreleased branch.
# - STUDIO_PLUGIN_CLIENTS / STUDIO_PLUGIN_DYNAMIC_CLIENTS: no ChatGPT/Claude connector against staging.
# - Runner/worker tokens: the server worker stays bound to production; code jobs are not available on staging.
# STUDIO_TRUSTED_PROXY_IPS=127.0.0.1

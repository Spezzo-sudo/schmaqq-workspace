[Unit]
Description=SCHMAQQ Hermes pilot isolation check for %i (no inference)
Documentation=https://github.com/Spezzo-sudo/schmaqq-workspace/issues/86
ConditionPathExists=/opt/hermes-agent/venv/bin/hermes

[Service]
Type=oneshot
User=schmaqq-hermes-%i
Group=schmaqq-hermes-%i
WorkingDirectory=/var/lib/schmaqq-hermes-%i
StateDirectory=schmaqq-hermes-%i
StateDirectoryMode=0700
Environment=HOME=/var/lib/schmaqq-hermes-%i
Environment=HERMES_HOME=/var/lib/schmaqq-hermes-%i
Environment=HERMES_MANAGED_DIR=/etc/schmaqq-hermes-pilot/managed-empty
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/hermes-agent/venv/bin/hermes --version
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=512M
TasksMax=64
TimeoutStartSec=30s

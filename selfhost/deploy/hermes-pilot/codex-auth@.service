[Unit]
Description=SCHMAQQ Hermes pilot: MANUAL personal Codex device login %i
Documentation=https://github.com/Spezzo-sudo/schmaqq-workspace/issues/86
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/schmaqq-hermes-pilot/runtime/python-3.11.15/bin/python3.11
ConditionPathExists=/opt/hermes-agent/venv/bin/hermes

[Service]
Type=oneshot
User=schmaqq-hermes-%i
Group=schmaqq-hermes-%i
WorkingDirectory=/var/lib/schmaqq-hermes-%i
StateDirectory=schmaqq-hermes-%i
StateDirectoryMode=0700
Environment=HOME=/var/lib/schmaqq-hermes-%i
Environment=HERMES_HOME=/var/lib/schmaqq-hermes-%i
Environment=HERMES_MANAGED_DIR=/etc/schmaqq-hermes-pilot/managed-empty
Environment=PYTHONPATH=/opt/hermes-agent/venv/lib/python3.11/site-packages:/opt/hermes-agent
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=HERMES_SAFE_MODE=1
Environment=HERMES_IGNORE_USER_CONFIG=1
Environment=HERMES_IGNORE_RULES=1
Environment=HTTPS_PROXY=http://127.0.0.60:3128
Environment=HTTP_PROXY=http://127.0.0.60:3128
Environment=NO_PROXY=127.0.0.1,localhost
ExecStart=/opt/schmaqq-hermes-pilot/runtime/python-3.11.15/bin/python3.11 /opt/hermes-agent/venv/bin/hermes auth add openai-codex --no-browser --label schmaqq-pilot-%i
Restart=no
TimeoutStartSec=960s
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=512M
TasksMax=64
CPUQuota=125%

# Deliberately no [Install]: cannot be enabled for autostart.

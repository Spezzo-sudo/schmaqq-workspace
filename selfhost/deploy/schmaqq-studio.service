[Unit]
Description=Schmaqq collaborative development workspace
After=network.target

[Service]
Type=simple
User=schmaqq-studio
Group=schmaqq-studio
WorkingDirectory=/opt/schmaqq-studio/current
EnvironmentFile=/etc/schmaqq-studio.env
# R4: dedicated, version-pinned Studio Node 24 runtime; never use /usr/bin/node (system Node 22).
# Verify executable, ownership, SHA256 and >=24.15 before enabling this template.
ExecStart=/opt/schmaqq-studio/runtime/node/bin/node selfhost/server.mjs
Restart=on-failure
RestartSec=5
StateDirectory=schmaqq-studio
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/schmaqq-studio
MemoryMax=256M
CPUQuota=50%
TasksMax=64

[Install]
WantedBy=multi-user.target

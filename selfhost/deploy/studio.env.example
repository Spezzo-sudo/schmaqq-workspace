STUDIO_ORIGIN=https://studio.example.com
STUDIO_PREVIEW_ORIGIN=https://preview.example.com
STUDIO_BIND=127.0.0.1
PORT=4310
STUDIO_PREVIEW_PORT=4311
STUDIO_DATA_DIR=/var/lib/schmaqq-studio
NODE_ENV=production

# Optional: registered ChatGPT website identity client (not a Codex client).
# STUDIO_CHATGPT_CLIENT_ID=
# STUDIO_CHATGPT_AUTH_METHOD=none
# STUDIO_CHATGPT_CLIENT_SECRET=

# Optional: own GitHub OAuth App for account verification only (read:user).
# Callback: STUDIO_ORIGIN/api/connections/github/callback
# STUDIO_GITHUB_CLIENT_ID=
# STUDIO_GITHUB_CLIENT_SECRET=
